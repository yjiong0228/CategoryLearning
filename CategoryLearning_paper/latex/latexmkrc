use Cwd qw(abs_path);
use File::Basename qw(dirname);

my $support_dir = abs_path(dirname(__FILE__));
my $source_dir = abs_path('.');

$ENV{'TEXINPUTS'} = "$support_dir//:" . ($ENV{'TEXINPUTS'} // '');
$ENV{'BSTINPUTS'} = "$support_dir//:" . ($ENV{'BSTINPUTS'} // '');
# BibTeX may run in a separate output directory.
$ENV{'BIBINPUTS'} = "$source_dir//:" . ($ENV{'BIBINPUTS'} // '');

1;
